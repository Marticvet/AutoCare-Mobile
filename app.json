{
  "expo": {
    "name": "AutoCare-Mobile",
    "slug": "AutoCare-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AutoCareIcon.png",
    "scheme": "myapp",
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marticvet.AutoCareMobile",
      "userInterfaceStyle": "light",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photo library to let you upload a profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/AutoCareIcon.png",
        "backgroundColor": "#ffffff",
        "userInterfaceStyle": "light"
      },
      "package": "com.marticvet.AutoCareMobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/AutoCareIcon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "AutoCare Hub accesses your photos so you can store vehicle documents and receipts.",
          "cameraPermission": "AutoCare Hub uses the camera to scan vehicle documents and receipts.",
          "microphonePermission": false
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "@journeyapps/react-native-quick-sqlite",
        {
          "staticLibrary": true
        }
      ],
      "expo-notifications",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "328791db-8e15-4bb1-928d-dddadb59567e"
      }
    },
    "owner": "marticvet"
  }
}

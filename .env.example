# Copy to .env for local development. Do not commit real values.
# Use development locally. `npm run ios:release:simulator` sets local-release
# and strips all RevenueCat keys from the non-distributable simulator build.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_POWERSYNC_URL=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Development builds only. Never provide this to preview or production.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# Required only by preview/production builds on the matching platform.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Optional links shown on the Subscription screen.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_FLEET_URL=

# This umbrella switch and each provider switch work only in development.
# Preview and production force both providers off. Do not enable Apple until
# its Apple Developer, Supabase, and physical-device setup has passed.
EXPO_PUBLIC_ENABLE_SOCIAL_AUTH=false
EXPO_PUBLIC_ENABLE_GOOGLE_AUTH=false
EXPO_PUBLIC_ENABLE_APPLE_AUTH=false

# Server-backed features are hidden unless both the service and its public
# release flag are configured. Leave these false for the initial v1 release.
EXPO_PUBLIC_ENABLE_RECEIPT_OCR=false
EXPO_PUBLIC_ENABLE_SCHEDULED_REPORTS=false
EXPO_PUBLIC_ENABLE_FLEET_BILLING=false

GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_POWERSYNC_URL=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Public Test Store SDK key used only by debug/development builds.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_jhyGnbSvPOTaFDfolqbXICrlMCu

# Public platform SDK keys used by release builds. Never put a RevenueCat
# secret API key in an EXPO_PUBLIC variable.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Optional links shown on the Subscription screen.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_FLEET_URL=

# Server-backed features are hidden unless both the service and its public
# release flag are configured. Leave these false for the initial v1 release.
EXPO_PUBLIC_ENABLE_RECEIPT_OCR=false
EXPO_PUBLIC_ENABLE_SCHEDULED_REPORTS=false
EXPO_PUBLIC_ENABLE_FLEET_BILLING=false

GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=